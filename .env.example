# Copia este archivo como ".env" para trabajar en local. En Vercel captura estas mismas
# variables en Settings > Environment Variables. Nunca subas el archivo .env a GitHub.

# Cadena de conexión de Neon (Dashboard > Connect). Usa la versión "pooled".
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Clave aleatoria para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="cambia-esto-por-una-clave-larga-y-aleatoria"

# Formulario de contacto (https://resend.com)
RESEND_API_KEY=""
# Correo que recibe las solicitudes de contacto
RECEIVER_EMAIL="jmarchitects.proyectos@gmail.com"
# Remitente: debe pertenecer a un dominio verificado en Resend.
# Mientras no verifiques un dominio, Resend solo permite onboarding@resend.dev y solo envía
# al correo con el que creaste la cuenta de Resend.
RESEND_FROM="JM Architects <onboarding@resend.dev>"

# Dominio definitivo (para Google, sitemap y vistas previas al compartir). Ej: https://www.jmarchitects.mx
SITE_URL=""

# Opcional: captcha invisible de Cloudflare Turnstile para reseñas y contacto.
# Si se dejan vacías, los formularios funcionan sin captcha.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
